{
  "name": "@seungyeop-lee/beads-desk",
  "version": "0.2.2",
  "description": "Local web UI for Beads (bd)",
  "keywords": [
    "bd",
    "beads",
    "issue-tracker",
    "kanban",
    "local-first",
    "web-ui"
  ],
  "homepage": "https://github.com/seungyeop-lee/beads-desk#readme",
  "bugs": {
    "url": "https://github.com/seungyeop-lee/beads-desk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "seungyeop-lee",
    "url": "https://github.com/seungyeop-lee"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seungyeop-lee/beads-desk.git",
    "directory": "packages/app"
  },
  "bin": {
    "bd-desk": "bin/bd-desk.js"
  },
  "files": [
    ".next/BUILD_ID",
    ".next/app-path-routes-manifest.json",
    ".next/build-manifest.json",
    ".next/export-marker.json",
    ".next/fallback-build-manifest.json",
    ".next/images-manifest.json",
    ".next/package.json",
    ".next/prerender-manifest.json",
    ".next/required-server-files.js",
    ".next/required-server-files.json",
    ".next/routes-manifest.json",
    ".next/server",
    ".next/static",
    "bin/bd-desk.js",
    "bin/daemon.js",
    "bin/workspaceRoot.js",
    "next.config.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p scripts && tsc --noEmit -p bin",
    "pack:local": "pnpm run build && node scripts/run-npm-release.mjs pack",
    "install:global": "pnpm run pack:local && pnpm add -g \"$PWD\"/seungyeop-lee-beads-desk-*.tgz; EXIT=$?; rm -f seungyeop-lee-beads-desk-*.tgz; exit $EXIT",
    "uninstall:global": "pnpm remove -g @seungyeop-lee/beads-desk",
    "test:e2e": "node e2e/support/runE2e.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@beads-desk/bd": "workspace:*",
    "@codemirror/language-data": "^6.5.2",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "7.22.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@xyflow/react": "^12.12.0",
    "daisyui": "^5.7.47",
    "mermaid": "^12.2.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-inline-links": "^7.0.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
